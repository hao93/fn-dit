#!/bin/bash
set -u

PID_FILE="${TRIM_PKGVAR}/fn-dit.pid"
LOG_FILE="${TRIM_PKGVAR}/service.log"
APP_DIR="${TRIM_APPDEST}/server"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
export PATH="/var/apps/nodejs_v22/target/bin:${PATH}"

fail() {
  printf '%s\n' "$1" >> "$LOG_FILE"
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "$TRIM_TEMP_LOGFILE"
  fi
  exit 1
}

running() {
  if [ -r "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  fi
  return 1
}

case "${1:-}" in
  start)
    if running; then exit 0; fi
    mkdir -p "$TRIM_PKGVAR" || exit 1
    if ! command -v node >/dev/null 2>&1; then
      fail '找不到 Node.js v22 运行时，请先安装飞牛 Node.js v22 应用。'
    fi
    node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || fail '需要 Node.js 22 或以上版本。'
    cd "$APP_DIR" || fail '找不到应用服务目录，请重新安装 FPK。'
    rm -f "$SOCKET_PATH"
    DIT_DATA_DIR="$TRIM_PKGVAR" DIT_SOCKET="$SOCKET_PATH" GATEWAY_PREFIX="/app/fn-dit" node server.js >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    for ((attempt=0; attempt<100; attempt++)); do
      if ! running; then
        rm -f "$PID_FILE" "$SOCKET_PATH"
        fail '服务启动失败，请查看应用数据目录中的 service.log。'
      fi
      if [ -S "$SOCKET_PATH" ]; then exit 0; fi
      sleep 0.1
    done
    "$0" stop
    fail '等待服务 Socket 超时，请查看 service.log。'
    ;;
  stop)
    if running; then
      pid="$(head -n 1 "$PID_FILE")"
      kill -TERM "$pid" 2>/dev/null || true
      count=0
      while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do
        sleep 1
        count=$((count+1))
      done
      if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
    fi
    rm -f "$PID_FILE"
    rm -f "$SOCKET_PATH"
    ;;
  status)
    if running; then exit 0; else exit 3; fi
    ;;
  *)
    printf '%s\n' 'Usage: main {start|stop|status}'
    exit 1
    ;;
esac
