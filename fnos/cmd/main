#!/bin/bash
set -u

PID_FILE="${TRIM_PKGVAR}/fn-dit.pid"
LOG_FILE="${TRIM_PKGVAR}/service.log"
APP_DIR="${TRIM_APPDEST}/server"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"
export PATH="/var/apps/nodejs_v22/target/bin:${PATH}"

running() {
  if [ -r "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  fi
  return 1
}

case "${1:-}" in
  start)
    if running; then exit 0; fi
    if ! command -v node >/dev/null 2>&1; then
      printf '%s\n' '找不到 Node.js v22 运行时，请先安装飞牛 Node.js v22 应用。' >> "$LOG_FILE"
      exit 1
    fi
    mkdir -p "$TRIM_PKGVAR"
    cd "$APP_DIR" || exit 1
    DIT_DATA_DIR="$TRIM_PKGVAR" DIT_SOCKET="$SOCKET_PATH" GATEWAY_PREFIX="/app/fn-dit" node server.js >> "$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
    ;;
  stop)
    if running; then
      pid="$(head -n 1 "$PID_FILE")"
      kill -TERM "$pid" 2>/dev/null || true
      count=0
      while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 15 ]; do
        sleep 1
        count=$((count+1))
      done
      if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
    fi
    rm -f "$PID_FILE"
    rm -f "$SOCKET_PATH"
    ;;
  status)
    if running; then exit 0; else exit 3; fi
    ;;
  *)
    printf '%s\n' 'Usage: main {start|stop|status}'
    exit 1
    ;;
esac
